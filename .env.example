# Copy this file to .env and adjust values.
# Docker Compose reads .env automatically for the variables below.

# --- PostgreSQL (used by the postgres container and by the backend) ---
POSTGRES_DB=dfs
POSTGRES_USER=dfs
POSTGRES_PASSWORD=change_me_please

# --- Backend settings (Docker Compose fills in the connection details itself) ---
CHUNK_SIZE_BYTES=1048576
MAX_UPLOAD_SIZE=200MB

# --- Host ports ---
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Local (non-Docker) runs only: these are read by the backend when you run it with Maven ---
# DB_URL=jdbc:postgresql://localhost:5432/dfs
# DB_USERNAME=dfs
# DB_PASSWORD=change_me_please
# STORAGE_ROOT=../storage
